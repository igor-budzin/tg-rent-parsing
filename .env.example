# Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telegram Bot token (get from @BotFather). Users subscribe with /start, unsubscribe with /stop.
BOT_TOKEN=your_bot_token_here

# Postgres connection string.
# On Railway: reference it as ${{Postgres.DATABASE_URL}}. With docker compose it is set automatically.
DATABASE_URL=postgres://tg_rent:tg_rent@localhost:5432/tg_rent

# Initial values, imported into the database on first start only (comma-separated).
# Afterwards channels are managed in the admin app and keywords by each account in the user app.
CHANNELS_TO_WATCH=
KEYWORDS=

# Both apps run on one port and are told apart by host: point both domains at this service.
# Local defaults: http://app.localhost:3000 and http://admin.localhost:3000
# For Telegram login on the user app, set the bot's domain in @BotFather (/setdomain) to APP_URL's host.
APP_URL=https://app.example.com
ADMIN_URL=https://admin.example.com

# First admin of the admin app, created on start while there are no admins yet.
# More admins and password changes: admin app → Тарифи.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# Free trial given once per Telegram user on their first account (optional, default: 3; 0 disables)
TRIAL_DAYS=3
# Shown to users whose subscription is ending or has ended (optional)
PAYMENT_INSTRUCTIONS=Оплата готівкою або переказом на картку — напишіть нам
SUPPORT_CONTACT=@your_support_username
# Matched posts hold phone numbers; they're deleted after this many days (optional, default: 30)
POST_RETENTION_DAYS=30

# Check interval in milliseconds (optional, default: 60000)
CHECK_INTERVAL_MS=60000

# OpenRouter API key for parsing matched posts (optional, get from https://openrouter.ai/keys).
# When empty, posts are sent as is. When AI fails, the post is queued and retried,
# then sent as is if every retry fails.
OPENROUTER_API_KEY=
# Models tried in order; OpenRouter switches to the next one on rate limits and errors
# (optional, comma-separated, up to 3). Free models have daily request caps.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-super-vl:free
# Max AI requests per minute; requests are spaced to stay under it (optional, default: 16; 0 disables)
OPENROUTER_MAX_RPM=16
# Retries for posts the AI failed to parse (optional, default: 3; 0 sends them as is right away)
PARSE_RETRY_ATTEMPTS=3
# Delay before the first retry in milliseconds, doubled for each next one (optional, default: 120000)
PARSE_RETRY_DELAY_MS=120000
