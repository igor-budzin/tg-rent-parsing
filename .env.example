# Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telegram Bot token (get from @BotFather). Users subscribe with /start, unsubscribe with /stop.
BOT_TOKEN=your_bot_token_here

# Postgres connection string.
# On Railway: reference it as ${{Postgres.DATABASE_URL}}. With docker compose it is set automatically.
DATABASE_URL=postgres://tg_rent:tg_rent@localhost:5432/tg_rent

# Initial values, imported into the database on first start only (comma-separated).
# Afterwards channels and keywords are managed in the web UI (Settings page).
CHANNELS_TO_WATCH=
KEYWORDS=

# Password for the web UI (any username)
ADMIN_PASSWORD=change_me

# Check interval in milliseconds (optional, default: 60000)
CHECK_INTERVAL_MS=60000

# Gemini API key for parsing matched posts (optional, get from https://aistudio.google.com/apikey).
# When empty or when AI fails, posts are sent as is.
GEMINI_API_KEY=
# Gemini model (optional, default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite
