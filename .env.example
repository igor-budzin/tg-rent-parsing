# Telegram API credentials
# Get these from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telegram Bot token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Postgres connection string for storing bot subscribers.
# Users subscribe by sending /start to the bot (/stop to unsubscribe).
# On Railway: add a Postgres service and reference it as ${{Postgres.DATABASE_URL}}
# With docker compose this is set automatically and can be left as is.
DATABASE_URL=postgres://tg_rent:tg_rent@localhost:5432/tg_rent

# Channels and keywords are managed in the web UI (Settings page).
# Optional: initial values, imported into the database on first start only (comma-separated)
CHANNELS_TO_WATCH=
KEYWORDS=

# Web UI for logging in to Telegram (QR code or phone number).
# Open it in a browser, any username + ADMIN_PASSWORD. The session is stored in the database.
ADMIN_PASSWORD=change_me
# Port for the web UI (optional, default: 3000; Railway sets it automatically)
PORT=3000

# Session string (optional, used only if the database has no valid session)
SESSION_STRING=

# Log level: error, warn, info, debug (optional, default: info)
LOG_LEVEL=info

# Check interval in milliseconds (optional, default: 60000)
CHECK_INTERVAL_MS=60000
